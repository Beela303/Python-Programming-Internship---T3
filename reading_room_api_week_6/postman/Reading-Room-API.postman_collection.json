{
  "info": {
    "name": "Reading Room API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Register, login, then use the returned token for book endpoints."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"reader@example.com\", \"password\": \"StrongPass123\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "reader@example.com"
            },
            {
              "key": "password",
              "value": "StrongPass123"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Things Fall Apart\", \"author\": \"Chinua Achebe\", \"genre\": \"Fiction\", \"status\": \"to_read\", \"publication_year\": 1958}"
        },
        "url": "{{baseUrl}}/api/v1/books"
      }
    },
    {
      "name": "List books (filter + pagination)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/books?page=1&page_size=10&genre=Fiction&status=to_read"
      }
    },
    {
      "name": "Get book",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/books/{{bookId}}"
      }
    },
    {
      "name": "Update book",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"reading\"}"
        },
        "url": "{{baseUrl}}/api/v1/books/{{bookId}}"
      }
    },
    {
      "name": "Delete book",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/books/{{bookId}}"
      }
    }
  ]
}